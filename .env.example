# ==============================================================================
# DocMind - Environment Configuration Template
# Copy this file to .env and populate with your actual keys.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Bright Data Scraper Studio & CLI Configuration
# ------------------------------------------------------------------------------
# Get your API token from Bright Data Dashboard -> Settings -> API Tokens
BRIGHTDATA_API_KEY=your_brightdata_api_token_here
# Collector ID created via `bdata scraper create` or Bright Data Scraper Studio
BRIGHTDATA_COLLECTOR_ID=your_collector_id_here
# Target documentation URL (must be public and have a sitemap)
TARGET_DOCS_URL=https://docs.litellm.ai

# ------------------------------------------------------------------------------
# Embedding Provider Configuration (Swappable: openai | cohere | voyage | ollama)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
# Works with plain OpenAI or any OpenAI-compatible provider (e.g. AI/ML API aimlapi.com)
EMBEDDING_API_KEY=your_openai_or_aimlapi_key_here
# Optional base_url: Set to https://api.aimlapi.com/v1 for AI/ML API, or leave commented for standard OpenAI
EMBEDDING_BASE_URL=https://api.aimlapi.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Cohere / Voyage / Ollama alternatives (uncomment & populate if switching provider)
# COHERE_API_KEY=your_cohere_api_key_here
# VOYAGE_API_KEY=your_voyage_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Swappable: openai | anthropic | groq | ollama)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
# Works with plain OpenAI or any OpenAI-compatible provider (e.g. AI/ML API aimlapi.com)
LLM_API_KEY=your_openai_or_aimlapi_key_here
# Optional base_url: Set to https://api.aimlapi.com/v1 for AI/ML API, or leave commented for standard OpenAI
LLM_BASE_URL=https://api.aimlapi.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Anthropic / Groq alternatives (uncomment & populate if switching provider)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Vector Database Configuration (Swappable: chroma | pinecone)
# ------------------------------------------------------------------------------
VECTOR_DB_PROVIDER=chroma

# ChromaDB Settings (Local persistence default)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=docmind_knowledge_base

# Pinecone Settings (Hosted persistence alternative)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=us-east-1-aws
# PINECONE_INDEX_NAME=docmind-index

# ------------------------------------------------------------------------------
# Pipeline & RAG Tunables
# ------------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.65
CHAT_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# Admin Panel & Security Configuration
# ------------------------------------------------------------------------------
# Bearer token or static API key for protecting admin routes
ADMIN_API_KEY=change_me_to_a_secure_random_admin_token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
SESSION_SECRET_KEY=change_me_to_a_random_32_character_secret_key
SESSION_TIMEOUT_MINUTES=30
